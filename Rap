#include <iostream>
using namespace std;

void heapify(int arr[],int i,int n,bool ismaxheap){
  int extreme=i;
  int left=2*i+1;
  int right=2*i+2;
  
  if (ismaxheap) {
    if(left<n && arr[left] > arr[extreme])
    extreme=left;
    if(right<n && arr[right] > arr[extreme])
    extreme=right;
  }
  else {
    if(left<n && arr[left] < arr[extreme])
    extreme=left;
    if(right<n && arr[right] < arr[extreme])
    extreme=right;
  }
  if (extreme != i){
    swap(arr[i], arr[extreme]);
    heapify(arr,n,extreme,ismaxheap);
    }
}
void heapsort(int arr[],int n,bool ismaxheap) {
  for(int i=n/2-1;i>=0;i--)
    heapify(arr,i,0,ismaxheap);
    
  for(int i=n-1;i>0;i--){
    swap(arr[0],arr[i]);
    heapify(arr,i,0,ismaxheap);
    
  if(!ismaxheap){
    for(int i=0;i<n/2;i++)
      swap(arr[i],arr[n-1-i]);
  }
}
}
int main() {
  int n;
  cout<<"Enter no. of element:";
  cin>>n;
  
  int arr[n];
  cout<<"Enter element: \n";
  for(int i=0;i<n;i++)
    cin>>arr[i];
    
  char heaptype;
  cout<<"Enter 'm' for max or 'n' for min:";
  cin>>heaptype;
  
  bool ismaxheap=(heaptype =='m');
  heapsort(arr,n,ismaxheap);
  
  cout<<"sorted arr: ";
  for(int i=0;i<n;i++)
    cout<<arr[i]<<" ";
  cout<<endl;
  return 0;
}
